  <style>
    .shop-card{
    background: #fff;
    border-radius: 20px;
    padding: 30px 20px;
    transition: 0.3s ease;
    box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    position: relative;
    overflow: hidden;
    height: 100%;
}

.shop-card:hover{
    transform: translateY(-8px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.12);
}

.shop-logo{
    height: 80px;
    display:flex;
    align-items:center;
    justify-content:center;
}

.shop-logo img{
    max-height: 60px;
    object-fit: contain;
}

.modern-btn{
    background-color: #89ADA3;
    color: #fff !important;
    border: none;
    padding: 12px 24px;
    border-radius: 50px;
    text-decoration: none;
    display: inline-block;
    transition: 0.3s ease;
    font-weight: 600;
}

.modern-btn:hover{
    background-color: #6f9489;
    color: #fff !important;
    text-decoration: none;
}

.wholesale-badge{
    position: absolute;
    top: 15px;
    right: -35px;
    background: #5a3d2b;
    color: #fff;
    padding: 5px 40px;
    font-size: 12px;
    transform: rotate(45deg);
    font-weight: 600;
}

@media (max-width: 768px){

    .shop-card{
        padding: 25px 18px;
    }

    .shop-logo{
